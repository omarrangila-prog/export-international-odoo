<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ei_intake_list" model="ir.ui.view">
        <field name="name">ei.supplier.intake.list</field>
        <field name="model">ei.supplier.intake</field>
        <field name="arch" type="xml">
            <list decoration-danger="state == 'mismatch'" decoration-success="state == 'billed'" decoration-muted="state == 'cancelled'">
                <field name="name"/><field name="partner_id"/><field name="invoice_number"/><field name="invoice_date"/>
                <field name="kind"/><field name="stated_total"/><field name="state" widget="badge"/>
            </list>
        </field>
    </record>
    <record id="ei_intake_form" model="ir.ui.view">
        <field name="name">ei.supplier.intake.form</field>
        <field name="model">ei.supplier.intake</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_check" string="Run checks" type="object" class="btn-primary" invisible="state not in ('draft', 'mismatch')"/>
                    <button name="action_override" string="Accept mismatch (approver)" type="object" invisible="state != 'mismatch'"
                            groups="ei_invoice_extensions.group_ei_invoice_approver"/>
                    <button name="action_create_bill" string="Create draft bill" type="object" class="btn-primary"
                            invisible="state not in ('matched', 'reviewed')"/>
                    <button name="action_ocr" string="Extract with OCR" type="object" invisible="state != 'draft'"/>
                    <button name="action_cancel" string="Cancel" type="object" invisible="state in ('billed', 'cancelled')"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,matched,billed"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <div class="alert alert-danger" role="alert" invisible="not issue_text"><field name="issue_text" nolabel="1"/></div>
                    <div class="text-muted"><field name="ocr_status"/></div>
                    <group>
                        <group>
                            <field name="kind"/><field name="partner_id"/><field name="invoice_number"/><field name="invoice_date"/>
                            <field name="original_id" invisible="kind != 'in_refund'"/>
                            <field name="currency_id" invisible="1"/><field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group>
                            <field name="tax_ids" widget="many2many_tags"/><field name="stated_tax"/><field name="stated_total"/>
                            <field name="untaxed"/><field name="expected_tax"/><field name="expected_total"/>
                            <field name="bill_id"/><field name="attachment_count"/>
                        </group>
                    </group>
                    <field name="line_ids">
                        <list editable="bottom" decoration-danger="received_mtl &gt; expected_mtl">
                            <field name="da_line_id"/><field name="order_line_id"/><field name="expected_mtl"/>
                            <field name="received_mtl"/><field name="hs_code" optional="show"/><field name="unit_rate"/><field name="expected_rate"/><field name="amount" sum="Total"/>
                            <field name="currency_id" column_invisible="1"/>
                        </list>
                    </field>
                    <group><field name="review_note"/><field name="reviewed_by"/><field name="maker_id"/></group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="ei_intake_action" model="ir.actions.act_window">
        <field name="name">Supplier Bills Intake</field>
        <field name="res_model">ei.supplier.intake</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="ei_lifting_billing_list" model="ir.ui.view">
        <field name="name">ei.lifting.billing.list</field>
        <field name="model">ei.lifting</field>
        <field name="arch" type="xml">
            <list create="0" decoration-success="invoice_status == 'invoiced'">
                <field name="name"/><field name="date"/><field name="customer_id"/><field name="da_id"/>
                <field name="verified_mtl" sum="MTL"/><field name="invoice_status" widget="badge"/>
                <field name="invoice_move_id"/><field name="billing_warning"/>
            </list>
        </field>
    </record>
    <record id="ei_billable_action" model="ir.actions.act_window">
        <field name="name">Ready to Invoice</field>
        <field name="res_model">ei.lifting</field>
        <field name="view_mode">list,form</field>
        <field name="view_ids" eval="[(5, 0, 0), (0, 0, {'view_mode': 'list', 'view_id': ref('ei_lifting_billing_list')})]"/>
        <field name="domain">[('state', '=', 'verified')]</field>
        <field name="context">{}</field>
    </record>
</odoo>
