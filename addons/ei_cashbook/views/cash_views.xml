<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ei_cash_decision_form" model="ir.ui.view">
        <field name="name">ei.cash.decision.wizard.form</field>
        <field name="model">ei.cash.decision.wizard</field>
        <field name="arch" type="xml">
            <form>
                <group><field name="decision" widget="radio"/><field name="reason" required="1"/></group>
                <footer>
                    <button string="Apply" name="action_apply" type="object" class="btn-primary"/>
                    <button string="Cancel" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="ei_cash_decision_action" model="ir.actions.act_window">
        <field name="name">Reject / reverse voucher</field>
        <field name="res_model">ei.cash.decision.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <record id="ei_cash_voucher_list" model="ir.ui.view">
        <field name="name">ei.cash.voucher.list</field>
        <field name="model">ei.cash.voucher</field>
        <field name="arch" type="xml">
            <list decoration-success="state == 'posted'" decoration-muted="state in ('rejected', 'reversed')">
                <field name="name"/><field name="date"/><field name="journal_id"/><field name="kind"/>
                <field name="category_id"/><field name="description"/><field name="amount" sum="Total"/>
                <field name="maker_id"/><field name="checker_id"/><field name="state" widget="badge"/>
            </list>
        </field>
    </record>
    <record id="ei_cash_voucher_form" model="ir.ui.view">
        <field name="name">ei.cash.voucher.form</field>
        <field name="model">ei.cash.voucher</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_submit" string="Submit" type="object" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_approve" string="Approve and post" type="object" class="btn-primary"
                            invisible="state != 'submitted'" groups="ei_cashbook.group_ei_cash_approver"/>
                    <button name="%(ei_cash_decision_action)d" string="Reject" type="action"
                            invisible="state != 'submitted'" groups="ei_cashbook.group_ei_cash_approver"
                            context="{'default_decision': 'reject'}"/>
                    <button name="%(ei_cash_decision_action)d" string="Reverse" type="action"
                            invisible="state != 'posted'" groups="ei_cashbook.group_ei_cash_approver"
                            context="{'default_decision': 'reverse'}"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,posted"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <group>
                            <field name="journal_id" readonly="state != 'draft'"/>
                            <field name="kind" readonly="state != 'draft'"/>
                            <field name="date" readonly="state != 'draft'"/>
                            <field name="amount" readonly="state != 'draft'"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                        <group>
                            <field name="category_id" readonly="state != 'draft'" invisible="kind not in ('payment', 'receipt')"/>
                            <field name="target_journal_id" readonly="state != 'draft'" invisible="kind not in ('bank_transfer', 'safe_transfer')"/>
                            <field name="partner_id" readonly="state != 'draft'"/>
                            <field name="party_code_id" readonly="state != 'draft'" options="{'no_create': True}"/>
                            <field name="reference_no" readonly="state != 'draft'"/>
                            <field name="description" readonly="state != 'draft'"/>
                            <field name="analytic_distribution" widget="analytic_distribution" readonly="state != 'draft'"
                                   options="{'product_field': 'product_id', 'account_field': 'account_id'}" invisible="1"/>
                        </group>
                    </group>
                    <group>
                        <group><field name="maker_id"/><field name="checker_id"/><field name="decided_at"/></group>
                        <group><field name="move_id"/><field name="reversal_move_id" invisible="not reversal_move_id"/>
                            <field name="reject_reason" invisible="not reject_reason"/>
                            <field name="reverse_reason" invisible="not reverse_reason"/>
                            <field name="attachment_count"/></group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="ei_cash_voucher_search" model="ir.ui.view">
        <field name="name">ei.cash.voucher.search</field>
        <field name="model">ei.cash.voucher</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/><field name="description"/><field name="category_id"/><field name="journal_id"/>
                <filter name="pending" string="Awaiting approval" domain="[('state', '=', 'submitted')]"/>
                <filter name="mine" string="My vouchers" domain="[('maker_id', '=', uid)]"/>
                <group>
                    <filter name="g_journal" string="Cash box" context="{'group_by': 'journal_id'}"/>
                    <filter name="g_cat" string="Category" context="{'group_by': 'category_id'}"/>
                    <filter name="g_day" string="Day" context="{'group_by': 'date:day'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="ei_cash_voucher_action" model="ir.actions.act_window">
        <field name="name">Cash Vouchers</field>
        <field name="res_model">ei.cash.voucher</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="ei_cash_count_list" model="ir.ui.view">
        <field name="name">ei.cash.count.list</field>
        <field name="model">ei.cash.count</field>
        <field name="arch" type="xml">
            <list decoration-danger="discrepancy != 0">
                <field name="date"/><field name="journal_id"/><field name="custodian_id"/>
                <field name="book_balance"/><field name="counted_amount"/><field name="discrepancy"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>
    <record id="ei_cash_count_form" model="ir.ui.view">
        <field name="name">ei.cash.count.form</field>
        <field name="model">ei.cash.count</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_close" string="Close day" type="object" class="btn-primary"
                            invisible="state == 'closed'" groups="ei_cashbook.group_ei_cash_approver"/>
                    <button name="action_post_discrepancy" string="Post difference" type="object"
                            invisible="state != 'closed' or discrepancy == 0 or adjustment_move_id"
                            groups="ei_cashbook.group_ei_cash_approver"/>
                    <button name="%(action_report_cash_count)d" string="Print cash book" type="action"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group><field name="journal_id" readonly="state == 'closed'"/><field name="date" readonly="state == 'closed'"/>
                            <field name="custodian_id" readonly="state == 'closed'"/><field name="currency_id" invisible="1"/></group>
                        <group><field name="opening_balance"/><field name="receipts"/><field name="payments"/>
                            <field name="book_balance"/><field name="counted_amount" readonly="state == 'closed'"/>
                            <field name="discrepancy"/></group>
                    </group>
                    <field name="line_ids" readonly="state == 'closed'">
                        <list editable="bottom"><field name="denomination"/><field name="quantity"/><field name="subtotal" sum="Total"/></list>
                    </field>
                    <group><field name="discrepancy_note" readonly="state == 'closed'"/><field name="adjustment_move_id"/>
                        <field name="closed_by"/><field name="closed_at"/></group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="ei_cash_count_action" model="ir.actions.act_window">
        <field name="name">Daily Cash Count</field>
        <field name="res_model">ei.cash.count</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="ei_cash_category_list" model="ir.ui.view">
        <field name="name">ei.cash.category.list</field>
        <field name="model">ei.cash.category</field>
        <field name="arch" type="xml">
            <list editable="bottom"><field name="name"/><field name="kind"/><field name="legacy_code_id"/>
                <field name="account_id"/><field name="company_id" groups="base.group_multi_company"/></list>
        </field>
    </record>
    <record id="ei_cash_category_action" model="ir.actions.act_window">
        <field name="name">Cash Categories</field>
        <field name="res_model">ei.cash.category</field>
        <field name="view_mode">list</field>
    </record>
</odoo>
