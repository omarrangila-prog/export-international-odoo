; /etc/odoo/odoo.conf for the live Export International system. install_ubuntu.sh fills the @@ values.
[options]
admin_passwd = @@MASTER_PASSWORD@@
db_host = False
db_port = False
db_user = odoo
db_password = False
db_name = @@DB_NAME@@
dbfilter = ^@@DB_NAME@@$
list_db = False                 ; no database manager page on the sign-in screen
addons_path = /usr/lib/python3/dist-packages/odoo/addons,/opt/export-international/addons
data_dir = /var/lib/odoo
proxy_mode = True               ; nginx in front: the real address of the visitor is used (PIN network rule, sign-in limits)
workers = @@WORKERS@@
max_cron_threads = 1
limit_memory_soft = 1342177280
limit_memory_hard = 1610612736
limit_time_cpu = 120
limit_time_real = 240
log_level = info
logfile = /var/log/odoo/odoo-server.log
without_demo = all
