<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_groups_privilege_ei_bank" model="res.groups.privilege">
        <field name="name">Export International - Banking</field>
        <field name="category_id" ref="base.module_category_accounting"/>
    </record>
    <record id="group_ei_bank_officer" model="res.groups">
        <field name="name">Bank officer (import and review)</field>
        <field name="privilege_id" ref="res_groups_privilege_ei_bank"/>
        <field name="implied_ids" eval="[(6, 0, [ref('ei_legacy_master.group_ei_user'), ref('account.group_account_invoice')])]"/>
    </record>
    <record id="group_ei_bank_approver" model="res.groups">
        <field name="name">Bank approver</field>
        <field name="privilege_id" ref="res_groups_privilege_ei_bank"/>
        <field name="implied_ids" eval="[(6, 0, [ref('ei_legacy_master.group_ei_user'), ref('account.group_account_invoice')])]"/>
    </record>
    <record id="group_ei_bank_poster" model="res.groups">
        <field name="name">Bank posting user</field>
        <field name="privilege_id" ref="res_groups_privilege_ei_bank"/>
        <field name="implied_ids" eval="[(6, 0, [ref('ei_legacy_master.group_ei_user'), ref('account.group_account_user')])]"/>
    </record>
</odoo>
