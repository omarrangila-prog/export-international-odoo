<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ============================================================ the workspace: one page for the four statements (previews) -->
    <record id="action_report_workspace" model="ir.actions.client">
        <field name="name">Financial reports (preview)</field>
        <field name="tag">ei_reports_workspace</field>
        <field name="params" eval="{'statement': 'summary'}"/>
    </record>
    <record id="action_report_pnl" model="ir.actions.client">
        <field name="name">Profit and loss (preview)</field>
        <field name="tag">ei_reports_workspace</field>
        <field name="params" eval="{'statement': 'pnl'}"/>
    </record>
    <record id="action_report_balance_sheet" model="ir.actions.client">
        <field name="name">Balance sheet (preview)</field>
        <field name="tag">ei_reports_workspace</field>
        <field name="params" eval="{'statement': 'balance_sheet'}"/>
    </record>
    <record id="action_report_trial_balance" model="ir.actions.client">
        <field name="name">Trial balance (preview)</field>
        <field name="tag">ei_reports_workspace</field>
        <field name="params" eval="{'statement': 'trial_balance'}"/>
    </record>
    <record id="action_report_cash_flow" model="ir.actions.client">
        <field name="name">Cash flow (preview)</field>
        <field name="tag">ei_reports_workspace</field>
        <field name="params" eval="{'statement': 'cash_flow'}"/>
    </record>

    <!-- ============================================================ scheduled delivery -->
    <record id="view_report_schedule_list" model="ir.ui.view">
        <field name="name">ei.report.schedule.list</field>
        <field name="model">ei.report.schedule</field>
        <field name="arch" type="xml">
            <list string="Scheduled delivery" decoration-muted="not enabled">
                <field name="name"/>
                <field name="statement"/>
                <field name="period_kind"/>
                <field name="frequency"/>
                <field name="recipient_ids" widget="many2many_tags"/>
                <field name="enabled" widget="boolean"/>
                <field name="next_run"/>
                <field name="last_run"/>
            </list>
        </field>
    </record>
    <record id="view_report_schedule_form" model="ir.ui.view">
        <field name="name">ei.report.schedule.form</field>
        <field name="model">ei.report.schedule</field>
        <field name="arch" type="xml">
            <form string="Scheduled delivery">
                <header>
                    <button name="action_switch_on" type="object" string="Switch on" class="btn-primary" invisible="enabled" groups="ei_management_dashboard.group_ei_management"
                            confirm="Switch on? From now on this PDF is emailed to the people listed, on the schedule shown."/>
                    <button name="action_switch_off" type="object" string="Switch off" invisible="not enabled"/>
                    <button name="action_send_test" type="object" string="Send a test to me"/>
                </header>
                <sheet>
                    <div class="alert alert-info" role="status" invisible="enabled">It is OFF: nothing is sent. Management switches it on after checking who receives it.</div>
                    <div class="alert alert-success" role="status" invisible="not enabled">It is ON. Next delivery: <field name="next_run" readonly="1" class="oe_inline"/>.</div>
                    <group>
                        <group>
                            <field name="name" readonly="enabled"/>
                            <field name="statement" readonly="enabled"/>
                            <field name="period_kind" readonly="enabled"/>
                            <field name="frequency" readonly="enabled"/>
                        </group>
                        <group>
                            <field name="recipient_ids" widget="many2many_tags" readonly="enabled" options="{'no_create': True}"/>
                            <field name="owner_id"/>
                            <field name="switched_on_by_id"/>
                            <field name="last_run"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="enabled" invisible="1"/>
                        </group>
                    </group>
                    <p class="text-muted">The PDF is a <b>preview</b> and is worked out as the person named above, so it shows only what that person may see. Recipients are colleagues who may see the report; an outside address cannot be added.</p>
                    <notebook>
                        <page string="What was sent" name="runs">
                            <field name="run_ids" readonly="1">
                                <list>
                                    <field name="at"/><field name="status" widget="badge"/><field name="test"/><field name="period_text"/><field name="recipients"/><field name="message"/><field name="attachment_id"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="view_report_schedule_search" model="ir.ui.view">
        <field name="name">ei.report.schedule.search</field>
        <field name="model">ei.report.schedule</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <filter name="on" string="Switched on" domain="[('enabled', '=', True)]"/>
                <filter name="off" string="Off" domain="[('enabled', '=', False)]"/>
            </search>
        </field>
    </record>
    <record id="action_report_schedule" model="ir.actions.act_window">
        <field name="name">Scheduled delivery</field>
        <field name="res_model">ei.report.schedule</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html"><p class="o_view_nocontent_smiling_face">Nothing is scheduled.</p><p>Choose a statement and who should receive it by email, then ask management to switch it on. It is off until then, every delivery is logged, and a test goes only to you.</p></field>
    </record>
    <record id="view_report_run_list" model="ir.ui.view">
        <field name="name">ei.report.schedule.run.list</field>
        <field name="model">ei.report.schedule.run</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0" decoration-danger="status == 'failed'" decoration-warning="status in ('queued', 'skipped')">
                <field name="at"/><field name="schedule_id"/><field name="status" widget="badge"/><field name="test"/><field name="period_text"/><field name="recipients"/><field name="message"/>
            </list>
        </field>
    </record>
    <record id="action_report_schedule_run" model="ir.actions.act_window">
        <field name="name">What was sent</field>
        <field name="res_model">ei.report.schedule.run</field>
        <field name="view_mode">list</field>
    </record>

    <record id="cron_report_schedule" model="ir.cron">
        <field name="name">Export International: send the scheduled report deliveries that are due</field>
        <field name="model_id" ref="model_ei_report_schedule"/>
        <field name="state">code</field>
        <field name="code">model._cron_run_due()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
