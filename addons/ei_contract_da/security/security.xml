<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_groups_privilege_ei_contract" model="res.groups.privilege">
        <field name="name">Export International - Contracts</field>
        <field name="category_id" ref="base.module_category_sales_sales"/>
    </record>
    <record id="group_ei_contract_staff" model="res.groups">
        <field name="name">Contract / DA staff (maker)</field>
        <field name="privilege_id" ref="res_groups_privilege_ei_contract"/>
        <field name="implied_ids" eval="[(6, 0, [ref('ei_legacy_master.group_ei_user'), ref('account.group_account_invoice')])]"/>
    </record>
    <record id="group_ei_contract_approver" model="res.groups">
        <field name="name">Contract approver (checker)</field>
        <field name="privilege_id" ref="res_groups_privilege_ei_contract"/>
        <field name="implied_ids" eval="[(6, 0, [ref('group_ei_contract_staff')])]"/>
    </record>
    <record id="group_ei_da_override" model="res.groups">
        <field name="name">Over-quantity authoriser</field>
        <field name="privilege_id" ref="res_groups_privilege_ei_contract"/>
        <field name="implied_ids" eval="[(6, 0, [ref('group_ei_contract_staff')])]"/>
    </record>
    <record id="group_ei_formula_approver" model="res.groups">
        <field name="name">Formula approver (accountant)</field>
        <field name="privilege_id" ref="res_groups_privilege_ei_contract"/>
        <field name="implied_ids" eval="[(6, 0, [ref('group_ei_contract_staff')])]"/>
    </record>
</odoo>
