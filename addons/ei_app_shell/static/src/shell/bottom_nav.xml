<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="ei_app_shell.BottomNav">
        <nav t-if="this.state.phone and !this.state.keyboard and this.buttons.length" class="ei-bn" aria-label="Main sections">
            <button t-foreach="this.buttons" t-as="b" t-key="b.key" type="button" t-att-class="'ei-bn-item' + (b.on ? ' is-on' : '')" t-att-aria-current="b.on ? 'page' : false"
                    t-att-aria-haspopup="b.section and b.section.home ? false : 'dialog'" t-on-click="() => this.press(b)">
                <svg class="ei-bn-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path t-att-d="b.icon"/></svg>
                <span class="ei-bn-label" t-out="b.label"/>
            </button>
        </nav>
        <div t-if="this.state.sheet" class="ei-sheet-wrap" t-on-click.self="() => this.close()">
            <div class="ei-sheet" role="dialog" aria-modal="true" t-att-aria-label="this.state.sheet.title">
                <header class="ei-sheet-head">
                    <h2 class="ei-sheet-title" t-out="this.state.sheet.title"/>
                    <button type="button" class="ei-sheet-x" aria-label="Close" t-on-click="() => this.close()"><svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><path t-att-d="this.icon('close')"/></svg></button>
                </header>
                <div class="ei-sheet-body">
                    <t t-foreach="this.state.sheet.groups" t-as="g" t-key="g_index">
                        <p t-if="g.name" class="ei-sheet-group" t-out="g.name"/>
                        <ul class="ei-sheet-list">
                            <li t-foreach="g.entries" t-as="e" t-key="e.id" t-att-class="g.pages ? 'ei-sheet-page' : ''">
                                <button type="button" class="ei-sheet-row" t-att-aria-current="e.on ? 'page' : false" t-on-click="() => g.pages ? this.openPage(e) : this.open(e)">
                                    <span t-out="e.name"/>
                                    <svg t-if="!g.pages" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path t-att-d="this.icon('chevron')"/></svg>
                                    <span t-elif="e.on" class="ei-sheet-here">Here</span>
                                </button>
                                <button t-if="g.pages" type="button" class="ei-sheet-closepage" t-att-aria-label="'Close ' + e.name" t-on-click.stop="() => this.closePage(e)">
                                    <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><path t-att-d="this.icon('close')"/></svg>
                                </button>
                            </li>
                        </ul>
                    </t>
                </div>
            </div>
        </div>
    </t>
</templates>
