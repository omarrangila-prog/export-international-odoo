<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ei_lifting_cancel_action" model="ir.actions.act_window">
        <field name="name">Reverse lifting</field>
        <field name="res_model">ei.reason.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{'default_res_model': 'ei.lifting', 'default_method': 'action_reverse'}</field>
    </record>
    <record id="ei_ownership_wizard_form" model="ir.ui.view">
        <field name="name">ei.ownership.wizard.form</field>
        <field name="model">ei.ownership.wizard</field>
        <field name="arch" type="xml">
            <form string="Classify stock ownership">
                <p class="text-muted">Who owns the material decides how its lifting is treated. It is set once, by a contract approver, with the reason.</p>
                <group><field name="contract_line_id" readonly="1"/><field name="ownership" widget="radio"/><field name="reason"/></group>
                <footer><button name="action_apply" string="Save" type="object" class="btn-primary"/><button special="cancel" string="Cancel"/></footer>
            </form>
        </field>
    </record>
    <record id="ei_lifting_list" model="ir.ui.view">
        <field name="name">ei.lifting.list</field>
        <field name="model">ei.lifting</field>
        <field name="arch" type="xml">
            <list decoration-success="state == 'verified'" decoration-muted="state in ('reversed', 'cancelled')">
                <field name="name"/><field name="date"/><field name="da_id"/><field name="customer_id"/><field name="vehicle_no"/>
                <field name="gate_pass_no"/><field name="claimed_mtl"/><field name="weighed_mtl"/>
                <field name="verified_mtl" sum="MTL"/><field name="state" widget="badge"/>
            </list>
        </field>
    </record>
    <record id="ei_lifting_form" model="ir.ui.view">
        <field name="name">ei.lifting.form</field>
        <field name="model">ei.lifting</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_verify" string="Save &amp; Continue" type="object" class="btn-primary" invisible="state != 'draft' or approval_mode != 'direct'" data-hotkey="s"/>
                    <field name="approval_mode" invisible="1"/>
                    <button name="action_verify" string="Verify lifting" type="object" class="btn-primary"
                            invisible="state != 'draft' or approval_mode == 'direct'" groups="ei_material_lifting.group_ei_lifting_reviewer"/>
                    <button name="%(ei_lifting_cancel_action)d" string="Reverse" type="action" invisible="state != 'verified'"
                            groups="ei_material_lifting.group_ei_lifting_reviewer"/>
                    <button name="action_open_ownership" string="Classify stock ownership" type="object"
                            invisible="state != 'draft' or ownership or not contract_line_id" groups="ei_contract_da.group_ei_contract_approver"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,verified"/>
                </header>
                <sheet>
                    <div class="o_row mb-2" title="Off by default: you confirm it yourself. Tick to have a second person check it.">
                        <field name="review_requested" readonly="state != 'draft'" widget="boolean_toggle"/><label for="review_requested"/>
                    </div>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <group>
                            <field name="da_line_id" readonly="state != 'draft'"/><field name="order_line_id" readonly="state != 'draft'"/>
                            <field name="customer_id"/><field name="date" readonly="state != 'draft'"/>
                            <field name="vehicle_no" readonly="state != 'draft'"/><field name="lot" readonly="state != 'draft'"/>
                        </group>
                        <group>
                            <field name="gate_pass_no" readonly="state != 'draft'"/>
                            <field name="weighbridge_no" readonly="state != 'draft'"/>
                            <field name="claimed_mtl" readonly="state != 'draft'"/>
                            <field name="gross_kg" readonly="state != 'draft'"/><field name="tare_kg" readonly="state != 'draft'"/>
                            <field name="net_kg"/><field name="weighed_mtl"/><field name="discrepancy_mtl"/>
                            <field name="verified_mtl"/>
                        </group>
                    </group>
                    <group>
                        <field name="discrepancy_note" readonly="state != 'draft'"/>
                        <field name="ownership"/><field name="stock_treatment"/><field name="contract_line_id" invisible="1"/>
                        <field name="received_on"/><field name="received_note"/>
                        <field name="maker_id"/><field name="verified_by"/><field name="reverse_reason" invisible="not reverse_reason"/>
                        <field name="attachment_count"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="ei_lifting_search" model="ir.ui.view">
        <field name="name">ei.lifting.search</field>
        <field name="model">ei.lifting</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/><field name="gate_pass_no"/><field name="vehicle_no"/><field name="da_id"/><field name="customer_id"/>
                <filter name="todo" string="To verify" domain="[('state', '=', 'draft')]"/>
                <group><filter name="g_da" string="DA" context="{'group_by': 'da_id'}"/>
                    <filter name="g_customer" string="Customer" context="{'group_by': 'customer_id'}"/>
                    <filter name="g_day" string="Day" context="{'group_by': 'date:day'}"/></group>
            </search>
        </field>
    </record>
    <record id="ei_lifting_action" model="ir.actions.act_window">
        <field name="name">Material Lifting</field>
        <field name="res_model">ei.lifting</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
