<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ei_legacy_code_list" model="ir.ui.view">
        <field name="name">ei.legacy.code.list</field>
        <field name="model">ei.legacy.code</field>
        <field name="arch" type="xml">
            <list decoration-warning="verification_status == 'needs_review'"
                  decoration-success="verification_status == 'approved'"
                  decoration-muted="verification_status == 'rejected'">
                <field name="legacy_code"/>
                <field name="original_name"/>
                <field name="nickname" optional="show"/>
                <field name="source_sheet_key"/>
                <field name="source_row" optional="hide"/>
                <field name="proposed_target_type" optional="show"/>
                <field name="approved_target_type"/>
                <field name="is_exception" optional="show"/>
                <field name="verification_status" widget="badge"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="ei_legacy_code_form" model="ir.ui.view">
        <field name="name">ei.legacy.code.form</field>
        <field name="model">ei.legacy.code</field>
        <field name="arch" type="xml">
            <form string="Legacy code" create="0" delete="0">
                <header>
                    <button name="%(ei_approve_wizard_action)d" string="Approve / Reject" type="action"
                            class="btn-primary" groups="ei_legacy_master.group_ei_mapping_approver"
                            invisible="verification_status == 'approved'"/>
                    <button name="action_reopen" string="Reopen" type="object"
                            groups="ei_legacy_master.group_ei_mapping_approver"
                            invisible="verification_status not in ('approved', 'rejected')"/>
                    <field name="verification_status" widget="statusbar"
                           statusbar_visible="proposed,needs_review,approved"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="legacy_code" class="me-3"/><field name="original_name"/></h1>
                    </div>
                    <div class="alert alert-warning" role="alert" invisible="not is_exception">
                        Exception reference: <field name="proposal_reason" nolabel="1" class="d-inline"/>.
                        It cannot be approved as a live bank or contact.
                    </div>
                    <group>
                        <group string="Source (read-only)">
                            <field name="source_sheet_key"/>
                            <field name="source_row"/>
                            <field name="nickname"/>
                            <field name="batch_id"/>
                            <field name="file_sha256"/>
                            <field name="last_batch_id"/>
                            <field name="last_sync"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group string="Mapping">
                            <field name="proposed_target_type"/>
                            <field name="approved_target_type"/>
                            <field name="is_exception"/>
                            <field name="verified_by"/>
                            <field name="verified_at"/>
                            <field name="linked_model"/>
                            <field name="linked_res_id"/>
                        </group>
                    </group>
                    <group><field name="approval_note"/><field name="notes"/></group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="ei_legacy_code_search" model="ir.ui.view">
        <field name="name">ei.legacy.code.search</field>
        <field name="model">ei.legacy.code</field>
        <field name="arch" type="xml">
            <search>
                <field name="legacy_code" filter_domain="[('legacy_code', '=ilike', self + '%')]"/>
                <field name="original_name"/>
                <field name="nickname"/>
                <field name="source_sheet_key"/>
                <filter name="queue" string="Unresolved queue"
                        domain="[('verification_status', 'in', ('unverified', 'proposed', 'needs_review'))]"/>
                <filter name="needs_review" string="Needs human classification"
                        domain="[('verification_status', '=', 'needs_review')]"/>
                <filter name="exceptions" string="Exception references" domain="[('is_exception', '=', True)]"/>
                <filter name="approved" string="Approved" domain="[('verification_status', '=', 'approved')]"/>
                <filter name="no_nick" string="No nickname" domain="[('nickname', '=', False)]"/>
                <group>
                    <filter name="g_sheet" string="Source sheet" context="{'group_by': 'source_sheet_key'}"/>
                    <filter name="g_status" string="Status" context="{'group_by': 'verification_status'}"/>
                    <filter name="g_target" string="Proposed target" context="{'group_by': 'proposed_target_type'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="ei_legacy_code_action" model="ir.actions.act_window">
        <field name="name">Legacy Codes</field>
        <field name="res_model">ei.legacy.code</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="ei_legacy_code_queue_action" model="ir.actions.act_window">
        <field name="name">Mapping Queue</field>
        <field name="res_model">ei.legacy.code</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_queue': 1, 'search_default_g_sheet': 1}</field>
    </record>
</odoo>
