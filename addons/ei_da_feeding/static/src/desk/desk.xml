<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="ei_da_feeding.Desk">
        <div class="o_action ei-fd">
            <header class="ei-fd-head">
                <div>
                    <h1 class="ei-fd-title">Feeding entry</h1>
                    <p class="ei-fd-sub">One screen: the DA, the three parties, the coils, the codes and the rates. Amounts in PKR. Save Draft, then Submit for Approval.</p>
                </div>
                <div t-if="this.showPractice" class="ei-fd-tabs" role="tablist" aria-label="Mode">
                    <button role="tab" t-att-aria-selected="this.state.tab === 'practice' ? 'true' : 'false'" t-att-class="'ei-fd-tab' + (this.state.tab === 'practice' ? ' is-on' : '')" t-on-click="() => this.setTab('practice')">Practice <small>nothing is posted</small></button>
                    <button role="tab" t-att-aria-selected="this.state.tab === 'real' ? 'true' : 'false'" t-att-class="'ei-fd-tab' + (this.state.tab === 'real' ? ' is-on' : '')" t-on-click="() => this.setTab('real')">Real entry <small>draft, then approval</small></button>
                </div>
            </header>
            <ol t-if="this.state.tab === 'real'" class="ei-fd-steps-bar" aria-label="Steps">
                <li t-foreach="['Choose document', 'Party and method', 'Rates and coils', 'Check and save']" t-as="s" t-key="s_index"
                    t-att-class="(s_index + 1 lt this.step ? 'is-done' : s_index + 1 === this.step ? 'is-on' : '')"
                    t-att-aria-current="s_index + 1 === this.step ? 'step' : false"><span t-out="s_index + 1"/><t t-out="s"/></li>
            </ol>
            <p t-if="this.state.error" class="ei-fd-error" role="alert" t-out="this.state.error"/>

            <!-- ================= PRACTICE ================= -->
            <section t-if="this.state.tab === 'practice' and this.state.lab" class="ei-fd-body" aria-label="Practice">
                <t t-set="lab" t-value="this.state.lab"/>
                <t t-set="inp" t-value="this.state.labInputs"/>
                <div class="ei-fd-train" role="note"><b>TRAINING</b> <span t-out="lab.note"/></div>
                <div class="ei-fd-card ei-fd-inputs">
                    <div class="ei-fd-fields">
                        <label class="ei-fd-field"><span>Basic rate / MTL</span><input class="ei-fd-in is-num" inputmode="decimal" t-att-value="inp.basic_rate" t-on-input="(ev) => this.labInput('basic_rate', ev)"/></label>
                        <label class="ei-fd-field"><span>Weight (kg)</span><input class="ei-fd-in is-num" inputmode="decimal" t-att-value="inp.weight_kg" t-on-input="(ev) => this.labInput('weight_kg', ev)"/><em class="ei-fd-hint">= <b class="ei-fd-num" t-out="lab.quantity"/> MTL</em></label>
                        <label class="ei-fd-field"><span>Credit note on the coil</span><input class="ei-fd-in is-num" inputmode="decimal" t-att-value="inp.cn_amount" t-on-input="(ev) => this.labInput('cn_amount', ev)"/></label>
                        <label class="ei-fd-field"><span>Direct: purchase rate</span><input class="ei-fd-in is-num" inputmode="decimal" t-att-value="inp.direct_purchase" t-on-input="(ev) => this.labInput('direct_purchase', ev)"/></label>
                        <label class="ei-fd-field"><span>Direct: sale rate</span><input class="ei-fd-in is-num" inputmode="decimal" t-att-value="inp.direct_sale" t-on-input="(ev) => this.labInput('direct_sale', ev)"/></label>
                    </div>
                    <div class="ei-fd-inrow">
                        <button class="ei-fd-link" t-on-click="() => this.toggle('rates')" t-att-aria-expanded="this.state.open.rates ? 'true' : 'false'">Rates used (18%, 0.1%, 1.32%)</button>
                        <span t-if="lab.formula" t-att-class="'ei-fd-chip ' + (lab.formula.state === 'approved' ? 'is-ok' : 'is-warn')">Formula <t t-out="lab.formula.code"/> v<t t-out="lab.formula.version"/>: <t t-out="lab.formula.state_label"/></span>
                        <span t-if="this.state.labBusy" class="ei-fd-muted">Working it out…</span>
                        <button class="ei-fd-link" t-on-click="() => this.resetLab()">Back to the sample numbers</button>
                    </div>
                    <div t-if="this.state.open.rates" class="ei-fd-fields is-small">
                        <label class="ei-fd-field"><span>Added to basic (%)</span><input class="ei-fd-in is-num" t-att-value="inp.params.sales_tax_pct" t-on-input="(ev) => this.labInput('sales_tax_pct', ev, 'params')"/></label>
                        <label class="ei-fd-field"><span>Added after that (%)</span><input class="ei-fd-in is-num" t-att-value="inp.params.additional_pct" t-on-input="(ev) => this.labInput('additional_pct', ev, 'params')"/></label>
                        <label class="ei-fd-field"><span>Dealer commission on basic (%)</span><input class="ei-fd-in is-num" t-att-value="inp.params.commission_pct" t-on-input="(ev) => this.labInput('commission_pct', ev, 'params')"/></label>
                        <label class="ei-fd-field"><span>Taken off the CN (%)</span><input class="ei-fd-in is-num" t-att-value="inp.params.cn_commission_pct" t-on-input="(ev) => this.labInput('cn_commission_pct', ev, 'params')"/></label>
                    </div>
                </div>
                <div class="ei-fd-grid">
                    <article t-foreach="lab.cards" t-as="c" t-key="c.key" t-att-class="'ei-fd-card ei-fd-method' + (c.ok ? ' is-' + c.result : ' is-off')" t-att-data-method="c.key">
                        <header class="ei-fd-mhead">
                            <span class="ei-fd-mno" t-out="c_index + 1"/>
                            <h2 class="ei-fd-mtitle" t-out="c.label"/>
                            <span t-if="c.ok" t-att-class="'ei-fd-chip is-' + (c.result === 'loss' ? 'bad' : c.result === 'profit' ? 'ok' : 'neutral')" t-out="c.result === 'loss' ? 'Loss' : c.result === 'profit' ? 'Profit' : 'Break-even'"/>
                            <span t-else="" class="ei-fd-chip is-warn">Waiting for the client</span>
                        </header>
                        <p t-if="c.ok" class="ei-fd-why" t-out="c.why"/>
                        <t t-if="c.ok">
                            <label t-if="this.isOffset(c.key)" class="ei-fd-offset"><span>Sale = mill rate</span><input class="ei-fd-in is-num" inputmode="decimal" t-att-value="inp.offsets[c.key]" t-on-input="(ev) => this.labInput(c.key, ev, 'offsets')" t-att-aria-label="'Amount added to the mill rate for ' + c.label"/></label>
                            <dl class="ei-fd-figs">
                                <div><dt>Purchase / MTL</dt><dd class="ei-fd-num" t-out="this.fmt(c.purchase_rate)"/></div>
                                <div><dt>Sale / MTL</dt><dd class="ei-fd-num" t-out="this.fmt(c.sale_rate)"/></div>
                                <div class="is-key"><dt>Spread / MTL</dt><dd class="ei-fd-num ei-fd-spread" t-out="this.signed(c.spread_per_mtl)"/></div>
                            </dl>
                            <p class="ei-fd-total">Over <b class="ei-fd-num" t-out="this.fmt(c.quantity, 3)"/> MTL: <b class="ei-fd-num" t-out="this.signed(c.total_spread)"/> <span class="ei-fd-muted">(gross spread, not booked profit)</span></p>
                            <button class="ei-fd-link" t-on-click="() => this.toggle(c.key)" t-att-aria-expanded="this.state.open[c.key] ? 'true' : 'false'">Show calculation</button>
                            <table t-if="this.state.open[c.key]" class="ei-fd-steps"><tbody>
                                <tr t-foreach="c.rows" t-as="r" t-key="r.key"><th scope="row" t-out="r.label"/><td class="ei-fd-num" t-out="this.fmt(r.value)"/></tr>
                            </tbody></table>
                        </t>
                        <p t-else="" class="ei-fd-pending" t-out="c.error"/>
                    </article>
                </div>
            </section>

            <!-- ================= REAL ENTRY ================= -->
            <section t-if="this.state.tab === 'real'" class="ei-fd-body ei-fd-real" aria-label="Real entry">
                <aside class="ei-fd-list" aria-label="Delivery advices">
                    <div class="ei-fd-listhead">
                        <h2>Delivery advices</h2>
                        <button t-if="this.state.list and this.state.list.can_create" class="ei-fd-btn is-primary is-sm" t-on-click="() => this.startNewDa()">New DA</button>
                    </div>
                    <p t-if="this.state.list and !this.state.list.rows.length" class="ei-fd-muted">No DA is waiting. Press New DA and type it from the paper.</p>
                    <button t-foreach="this.state.list ? this.state.list.rows : []" t-as="r" t-key="r.id" t-att-class="'ei-fd-darow' + (this.state.da and this.state.da.id === r.id ? ' is-on' : '')" t-on-click="() => this.openDa(r.id)">
                        <b t-out="r.name"/><span class="ei-fd-chip is-neutral" t-out="r.state_label"/>
                        <small><t t-out="r.parent"/> · <t t-out="r.date"/> · <t t-out="r.coils"/> coil(s)</small>
                    </button>
                </aside>

                <div class="ei-fd-main">
                    <!-- a new DA, typed from the paper -->
                    <div t-if="this.state.newDa" class="ei-fd-card">
                        <h2 class="ei-fd-h2">New feeding entry <span class="ei-fd-muted">one DA, typed as printed · amounts in PKR</span></h2>
                        <div class="ei-fd-fields">
                            <label class="ei-fd-field"><span>Entry date</span><input class="ei-fd-in" type="date" t-att-value="this.state.newDa.date" t-on-input="(ev) => this.state.newDa.date = ev.target.value"/></label>
                            <label class="ei-fd-field"><span>DO / DA No</span><input id="ei-fd-daname" class="ei-fd-in" t-att-value="this.state.newDa.name" t-on-input="(ev) => this.state.newDa.name = ev.target.value"/></label>
                        </div>
                        <div class="ei-fd-parties" role="group" aria-label="The three parties">
                            <label class="ei-fd-field"><span>SUPPLIER (Purchase From)</span>
                                <select id="ei-fd-supplier" class="ei-fd-in" t-att-disabled="!!this.state.newDa.contract_id" t-on-change="(ev) => this.state.newDa.supplier_id = ev.target.value">
                                    <option value="">Choose the mill…</option>
                                    <option t-foreach="this.state.list.suppliers" t-as="p" t-key="p.id" t-att-value="p.id" t-att-selected="this.str(p.id) === this.state.newDa.supplier_id" t-out="p.name"/>
                                </select></label>
                            <span class="ei-fd-arrow" aria-hidden="true">→</span>
                            <label class="ei-fd-field"><span>Purchase (IN)</span>
                                <select id="ei-fd-pin" class="ei-fd-in" t-on-change="(ev) => this.state.newDa.purchase_in_id = ev.target.value">
                                    <option value="">Choose the buying entity…</option>
                                    <option t-foreach="this.state.list.purchase_ins" t-as="p" t-key="p.id" t-att-value="p.id" t-att-selected="this.str(p.id) === this.state.newDa.purchase_in_id" t-out="p.name"/>
                                </select></label>
                            <span class="ei-fd-arrow" aria-hidden="true">→</span>
                            <div class="ei-fd-field ei-fd-sold"><span>Sold (OUT)</span>
                                <div t-if="this.state.newDa.sold_out_id" class="ei-fd-picked"><span t-out="this.state.newDa.sold_out_name"/><button class="ei-fd-link" t-on-click="() => this.clearSoldOut()">Change</button></div>
                                <t t-else="">
                                    <input id="ei-fd-sold" class="ei-fd-in" autocomplete="off" placeholder="Customer name or code · leave empty if not sold yet" t-att-value="this.state.partyLook.term" t-on-input="(ev) => this.partyLookInput(ev)"/>
                                    <ul t-if="this.state.partyLook.rows.length" class="ei-fd-lookrows" role="listbox">
                                        <li t-foreach="this.state.partyLook.rows" t-as="o" t-key="o.id"><button role="option" t-on-click="() => this.pickSoldOut(o)"><t t-out="o.name"/><small t-if="o.ref" class="ei-fd-muted"> · <t t-out="o.ref"/></small></button></li>
                                    </ul>
                                </t>
                            </div>
                        </div>
                        <p t-if="!this.state.list.suppliers.length or !this.state.list.purchase_ins.length" class="ei-fd-warnbox">No supplier or buying entity is set up yet. An administrator ticks "Supplier (Purchase From)" and "Purchase (IN) entity" on those companies in Customers &amp; Suppliers.</p>
                        <details class="ei-fd-more">
                            <summary>More details</summary>
                            <div class="ei-fd-fields">
                                <label class="ei-fd-field is-wide"><span>Customer name printed on the DA</span><input class="ei-fd-in" t-att-value="this.state.newDa.printed_customer" t-on-input="(ev) => this.state.newDa.printed_customer = ev.target.value"/></label>
                                <label class="ei-fd-field"><span>Order date and time (printed)</span><input class="ei-fd-in" type="datetime-local" t-att-value="this.state.newDa.order_datetime" t-on-input="(ev) => this.state.newDa.order_datetime = ev.target.value"/></label>
                                <label class="ei-fd-field"><span>Ship date (printed)</span><input class="ei-fd-in" type="date" t-att-value="this.state.newDa.ship_date" t-on-input="(ev) => this.state.newDa.ship_date = ev.target.value"/></label>
                                <label class="ei-fd-field is-wide"><span>Against a signed contract (only when one exists)</span>
                                    <select id="ei-fd-contract" class="ei-fd-in" t-on-change="(ev) => this.state.newDa.contract_id = ev.target.value">
                                        <option value="">No signed contract</option>
                                        <option t-foreach="this.signedContracts" t-as="c" t-key="c.id" t-att-value="c.id" t-att-selected="this.str(c.id) === this.state.newDa.contract_id" t-out="c.name"/>
                                    </select></label>
                            </div>
                        </details>
                        <div class="ei-fd-actions"><button class="ei-fd-btn" t-on-click="() => this.state.newDa = null">Cancel</button><button class="ei-fd-btn is-primary" t-att-disabled="this.state.busy" t-on-click="() => this.createDa()">Create draft DA</button></div>
                    </div>

                    <p t-if="!this.state.da and !this.state.newDa" class="ei-fd-empty">Choose a DA on the left, or press <b>New DA</b>.</p>

                    <t t-if="this.state.da and !this.state.newDa">
                        <t t-set="d" t-value="this.state.da"/>
                        <div class="ei-fd-dahead">
                            <div>
                                <h2 class="ei-fd-daname">DA <t t-out="d.name"/> <span t-att-class="'ei-fd-chip ' + (d.state === 'draft' ? 'is-neutral' : 'is-warn')" t-out="d.state_label"/></h2>
                                <p class="ei-fd-chain"><b t-out="d.supplier"/> <span aria-hidden="true">→</span> <b t-out="d.purchase_in or 'Purchase (IN) not set'"/> <span aria-hidden="true">→</span>
                                    <b t-if="d.sold_out" t-out="d.sold_out.name"/><span t-else="" class="ei-fd-chip is-neutral">Not sold yet</span></p>
                                <p class="ei-fd-muted"><t t-if="!d.is_feeding">contract <t t-out="d.contract"/> · </t><b t-out="d.currency"/><t t-if="d.fx_text"> · <span t-att-class="d.fx_missing ? 'ei-fd-bad' : ''" t-out="d.fx_text"/></t></p>
                            </div>
                            <div class="ei-fd-actions">
                                <span class="ei-fd-muted"><b class="ei-fd-num" t-out="this.fmt(d.total_mtl, 3)"/> MTL on <t t-out="d.lines.length"/> coil(s)</span>
                                <button t-if="d.editable and this.state.list and this.state.list.can_delete" class="ei-fd-btn is-ghost ei-fd-danger is-sm" t-on-click="() => this.deleteDa()">Delete draft</button>
                                <label t-if="d.editable and !d.approval_on" class="ei-fd-review" title="Tick only when someone else should check this DA first.">
                                    <input type="checkbox" t-att-checked="this.state.review" t-on-change="(ev) => this.state.review = ev.target.checked"/>
                                    <span>Send for review</span>
                                </label>
                                <span t-elif="d.editable" class="ei-fd-muted" title="Maker-checker: a different authorised person approves every DA.">A different person approves it</span>
                                <button t-if="d.editable" class="ei-fd-btn is-primary" t-att-disabled="this.state.busy or !d.lines.length" t-on-click="() => this.submit()"
                                        t-out="d.approval_on ? 'Submit for Approval' : 'Save &amp; Continue'"/>
                            </div>
                        </div>
                        <div t-if="this.state.next or d.state === 'approved'" class="ei-fd-done" role="status">
                            <b>DA confirmed<t t-if="d.approved_by"> by <t t-out="d.approved_by"/></t>.</b>
                            <t t-if="this.state.next and this.state.next.error"> The daily order could not be prepared: <t t-out="this.state.next.error"/></t>
                            <t t-elif="this.state.next"> Next task: daily order request <b t-out="this.state.next.name"/> (<t t-out="this.state.next.state"/>).
                                <button class="ei-fd-btn is-primary is-sm" t-on-click="() => this.openNext()">Open the daily order</button></t>
                        </div>
                        <div t-elif="d.state === 'under_review'" class="ei-fd-done is-wait" role="status">
                            <t t-if="d.approval and d.approval.needs_assignment"><b>Assignment required.</b> No other person holds the approver role yet; an administrator has been told.</t>
                            <t t-elif="d.approval and d.approval.approver"><b>Pending approval.</b> Checker: <b t-out="d.approval.approver"/>. You will be told when it is approved or returned.</t>
                            <t t-else=""><b>Waiting for review.</b> An approver checks this DA before it is confirmed.</t>
                            <button t-if="d.approval and d.approval.request_id" class="ei-fd-btn is-sm" t-on-click="() => this.openApproval()">Open in Approvals</button>
                        </div>
                        <div t-elif="d.approval and (d.approval.state === 'returned' or d.approval.state === 'superseded' or d.approval.state === 'withdrawn')" class="ei-fd-warnbox" role="alert">
                            <b t-out="d.approval.state === 'withdrawn' ? 'Withdrawn from approval.' : 'Returned for correction'"/><t t-if="d.approval.decided_by and d.approval.state === 'returned'"> by <t t-out="d.approval.decided_by"/></t><t t-if="d.approval.note and d.approval.state !== 'withdrawn'">: <i t-out="d.approval.note"/></t>.
                            Correct the coils, then press Submit for Approval again.
                        </div>
                        <div class="ei-fd-split">
                            <!-- the paper -->
                            <div class="ei-fd-card ei-fd-paper" aria-label="The DA paper">
                                <div class="ei-fd-paperhead">
                                    <b>The paper</b>
                                    <select t-if="d.attachments.length gt 1" class="ei-fd-in is-sm" t-on-change="(ev) => this.state.docIndex = this.toInt(ev.target.value)">
                                        <option t-foreach="d.attachments" t-as="a" t-key="a.id" t-att-value="a_index" t-out="a.name"/>
                                    </select>
                                    <label t-if="d.editable" class="ei-fd-btn is-sm">Attach the DA paper<input type="file" accept="application/pdf,image/*" class="visually-hidden" t-on-change="(ev) => this.attach(ev)"/></label>
                                </div>
                                <t t-if="this.doc">
                                    <img t-if="this.isImage(this.doc)" class="ei-fd-docimg" t-att-src="this.docUrl(this.doc)" t-att-alt="this.doc.name"/>
                                    <iframe t-elif="this.doc.mimetype === 'application/pdf'" class="ei-fd-docframe" t-att-src="this.docUrl(this.doc)" t-att-title="this.doc.name"/>
                                    <a t-else="" t-att-href="'/web/content/' + this.doc.id + '?download=true'">Download <t t-out="this.doc.name"/></a>
                                </t>
                                <p t-else="" class="ei-fd-muted">No paper attached yet. Attach the DA as it came from the parent; it cannot be sent for review without it.</p>
                            </div>

                            <div class="ei-fd-work">
                                <!-- step 1: what the paper says -->
                                <div class="ei-fd-card">
                                    <h3 class="ei-fd-step"><span>1</span>What the paper says</h3>
                                    <div class="ei-fd-fields">
                                        <label class="ei-fd-field is-wide"><span>Customer name printed on the DA</span><input class="ei-fd-in" t-att-readonly="!d.editable" t-att-value="this.state.header.printed_customer" t-on-input="(ev) => this.state.header.printed_customer = ev.target.value"/></label>
                                        <label class="ei-fd-field"><span>Order date and time</span><input class="ei-fd-in" type="datetime-local" t-att-readonly="!d.editable" t-att-value="this.state.header.order_datetime" t-on-input="(ev) => this.state.header.order_datetime = ev.target.value"/></label>
                                        <label class="ei-fd-field"><span>Ship date</span><input class="ei-fd-in" type="date" t-att-readonly="!d.editable" t-att-value="this.state.header.ship_date" t-on-input="(ev) => this.state.header.ship_date = ev.target.value"/></label>
                                        <label class="ei-fd-field"><span>DA date</span><input class="ei-fd-in" type="date" t-att-readonly="!d.editable" t-att-value="this.state.header.date" t-on-input="(ev) => this.state.header.date = ev.target.value"/></label>
                                    </div>
                                    <div t-if="d.editable" class="ei-fd-actions"><button class="ei-fd-btn is-sm" t-on-click="() => this.saveHeader()">Save these details</button></div>
                                </div>

                                <!-- the coils -->
                                <div class="ei-fd-card">
                                    <div class="ei-fd-listhead"><h3 class="ei-fd-step"><span>2</span>Coils</h3>
                                        <span t-if="d.editable and !this.state.line" class="ei-fd-actions">
                                            <button t-if="d.lines.length" class="ei-fd-btn is-sm" t-on-click="() => this.copyPrevious()">Copy Previous</button>
                                            <button class="ei-fd-btn is-primary is-sm" t-on-click="() => this.newLine()">Add Coil</button></span></div>
                                    <p t-if="!d.lines.length" class="ei-fd-muted">No coil yet. Add each coil printed on the DA.</p>
                                    <div t-else="" class="ei-fd-tablewrap" tabindex="0" role="region" aria-label="Coils on this DA">
                                        <table class="ei-fd-table">
                                            <thead><tr><th>Coil</th><th class="ei-fd-r">MTL</th><th>Method</th><th class="ei-fd-r">Purchase</th><th class="ei-fd-r">Sale</th><th class="ei-fd-r">Spread / MTL</th><th>Check</th><th/></tr></thead>
                                            <tbody>
                                                <tr t-foreach="d.lines" t-as="r" t-key="r.id">
                                                    <th scope="row"><t t-out="r.coil_no or r.product"/><small t-if="r.customer_code" class="ei-fd-muted"> · <t t-out="r.customer_code.code"/></small></th>
                                                    <td class="ei-fd-r ei-fd-num" t-out="this.fmt(r.mtl, 3)"/>
                                                    <td t-out="r.method_label"/>
                                                    <td class="ei-fd-r ei-fd-num" t-out="this.fmt(r.purchase_rate)"/>
                                                    <td class="ei-fd-r ei-fd-num" t-out="this.fmt(r.sale_rate)"/>
                                                    <td t-att-class="'ei-fd-r ei-fd-num' + (r.spread lt 0 ? ' ei-fd-bad' : '')" t-out="this.signed(r.spread)"/>
                                                    <td><span t-if="r.code_issue" class="ei-fd-chip is-warn" t-att-title="r.code_issue">Code to check</span><span t-else="" class="ei-fd-chip is-ok">Ready</span></td>
                                                    <td class="ei-fd-r ei-fd-rowacts"><t t-if="d.editable"><button class="ei-fd-link" t-on-click="() => this.editLine(r)">Edit</button>
                                                        <button class="ei-fd-link" t-on-click="() => this.duplicateLine(r)" t-att-aria-label="'Duplicate row ' + (r.coil_no or '')">Duplicate</button></t></td>
                                                </tr>
                                            </tbody>
                                            <tfoot><tr><th scope="row"><t t-out="d.lines.length"/> coil(s)</th><td class="ei-fd-r ei-fd-num" t-out="this.fmt(d.total_mtl, 3)"/>
                                                <td colspan="3" class="ei-fd-muted">Expected gross spread</td>
                                                <td t-att-class="'ei-fd-r ei-fd-num' + (d.total_spread lt 0 ? ' ei-fd-bad' : '')" t-out="this.signed(d.total_spread) + ' ' + d.currency"/><td colspan="2"/></tr></tfoot>
                                        </table>
                                    </div>
                                </div>

                                <!-- the coil being fed -->
                                <div t-if="this.state.line" class="ei-fd-card ei-fd-editor" aria-label="Coil being fed">
                                    <t t-set="l" t-value="this.state.line"/>
                                    <h3 class="ei-fd-step"><span>3</span>The coil and who buys it</h3>
                                    <div class="ei-fd-fields">
                                        <div t-if="d.is_feeding" class="ei-fd-field is-wide ei-fd-item"><span>Item</span>
                                            <div t-if="this.cl and !this.state.itemLook" class="ei-fd-picked"><span t-out="this.cl.name"/><small t-if="this.cl.formula" class="ei-fd-muted"> · <t t-out="this.cl.formula"/></small>
                                                <button class="ei-fd-link" t-on-click="() => this.openItems()">Change</button></div>
                                            <t t-else="">
                                                <input id="ei-fd-item" class="ei-fd-in" autocomplete="off" placeholder="Type the item name…" t-att-value="this.state.itemLook ? this.state.itemLook.term : ''" t-on-focus="() => this.state.itemLook or this.openItems()" t-on-input="(ev) => this.itemLookInput(ev)"/>
                                                <ul t-if="this.state.itemLook and this.state.itemLook.rows.length" class="ei-fd-lookrows" role="listbox">
                                                    <li t-foreach="this.state.itemLook.rows" t-as="o" t-key="o.id"><button role="option" t-on-click="() => this.pickItem(o)" t-out="o.name"/></li>
                                                </ul>
                                            </t>
                                        </div>
                                        <label t-else="" class="ei-fd-field is-wide"><span>Material (contract line)</span>
                                            <select class="ei-fd-in" t-on-change="(ev) => this.setLine('contract_line_id', ev)">
                                                <option value="">Choose…</option>
                                                <option t-foreach="d.contract_lines" t-as="c" t-key="c.id" t-att-value="c.id" t-att-selected="this.str(c.id) === this.str(l.contract_line_id)" t-out="c.name + ' · ' + this.fmt(c.free_mtl, 3) + ' MTL free' + (c.formula ? ' · ' + c.formula : '')"/>
                                            </select></label>
                                        <label class="ei-fd-field"><span>Coil number</span><input id="ei-fd-coil" class="ei-fd-in" t-att-value="l.coil_no" t-on-input="(ev) => this.setLine('coil_no', ev)"/></label>
                                        <label class="ei-fd-field is-short"><span>Grade</span><input class="ei-fd-in" t-att-value="l.grade" t-on-input="(ev) => this.setLine('grade', ev)"/></label>
                                        <label class="ei-fd-field is-short"><span>Thickness</span><input class="ei-fd-in" t-att-value="l.thickness" t-on-input="(ev) => this.setLine('thickness', ev)"/></label>
                                        <label class="ei-fd-field is-short"><span>Width</span><input class="ei-fd-in" t-att-value="l.width" t-on-input="(ev) => this.setLine('width', ev)"/></label>
                                        <label class="ei-fd-field"><span>Weight (kg)</span><input class="ei-fd-in is-num" inputmode="decimal" t-att-value="l.weight_kg" t-on-input="(ev) => this.setLine('weight_kg', ev)"/><em class="ei-fd-hint" t-if="this.mtl">= <b class="ei-fd-num" t-out="this.mtl"/> MTL</em></label>
                                    </div>
                                    <div class="ei-fd-picks">
                                        <div t-foreach="['customer', 'customer_code', 'trade_code', 'pl_code']" t-as="f" t-key="f" class="ei-fd-pick">
                                            <span class="ei-fd-picklabel" t-out="this.lookLabel(f)"/>
                                            <div t-if="l[f]" class="ei-fd-picked">
                                                <span t-if="f === 'customer'" t-out="l[f].name"/>
                                                <span t-else=""><b class="ei-fd-num" t-out="l[f].code"/> <t t-out="l[f].name"/><small t-if="l[f].nick" class="ei-fd-muted"> (<t t-out="l[f].nick"/>)</small><span t-if="!l[f].verified" class="ei-fd-chip is-warn">not verified</span></span>
                                                <button class="ei-fd-link" t-on-click="() => this.openLook(f)">Change</button><button class="ei-fd-link" t-on-click="() => this.clearPick(f)">Clear</button>
                                            </div>
                                            <button t-else="" class="ei-fd-btn is-sm is-ghost" t-on-click="() => this.openLook(f)">Choose <t t-out="this.lookWord(f)"/>…</button>
                                            <div t-if="this.state.look.field === f" class="ei-fd-look">
                                                <input id="ei-fd-look" class="ei-fd-in" autocomplete="off" t-att-placeholder="f === 'customer' ? 'Type a name…' : 'Type a code, a name or a nickname…'" t-att-value="this.state.look.term" t-on-input="(ev) => this.lookInput(ev)" t-on-keydown="(ev) => this.lookKey(ev)"/>
                                                <p t-if="f !== 'customer' and !this.state.look.term and this.state.look.rows.length" class="ei-fd-muted">Suggested from the printed name. Check them against the paper; nothing is chosen for you.</p>
                                                <ul class="ei-fd-lookrows" role="listbox">
                                                    <li t-foreach="this.state.look.rows" t-as="o" t-key="o.id"><button role="option" t-on-click="() => this.choose(o)">
                                                        <t t-if="f === 'customer'"><t t-out="o.name"/><small t-if="o.ref" class="ei-fd-muted"> · <t t-out="o.ref"/></small></t>
                                                        <t t-else=""><b class="ei-fd-num" t-out="o.code"/> <t t-out="o.name"/><small t-if="o.nick" class="ei-fd-muted"> (<t t-out="o.nick"/>)</small> <span t-if="!o.verified" class="ei-fd-chip is-warn" t-out="o.status"/></t>
                                                    </button></li>
                                                </ul>
                                                <p t-if="!this.state.look.busy and this.state.look.term and !this.state.look.rows.length" class="ei-fd-muted">Nothing found.</p>
                                            </div>
                                        </div>
                                    </div>

                                    <h3 class="ei-fd-step"><span>4</span>Feeding method</h3>
                                    <div class="ei-fd-methods" role="radiogroup" aria-label="Feeding method">
                                        <button t-foreach="this.state.methods" t-as="m" t-key="m.key" role="radio" t-att-aria-checked="l.method === m.key ? 'true' : 'false'"
                                                t-att-class="'ei-fd-mpick' + (l.method === m.key ? ' is-on' : '') + (m.ready ? '' : ' is-off')" t-att-disabled="!m.ready" t-att-title="m.why" t-on-click="() => this.pickMethod(m.key)">
                                            <b t-out="m.label"/><small t-out="m.ready ? m.why : 'Waiting for the client example and the accountant rule'"/>
                                        </button>
                                    </div>
                                    <div t-if="l.method" class="ei-fd-fields">
                                        <t t-if="this.lineBasis === 'direct'">
                                            <label class="ei-fd-field"><span>Purchase rate / MTL</span><input class="ei-fd-in is-num" inputmode="decimal" t-att-value="l.purchase_rate" t-on-input="(ev) => this.setLine('purchase_rate', ev)"/></label>
                                            <label class="ei-fd-field"><span>Sale rate / MTL</span><input class="ei-fd-in is-num" inputmode="decimal" t-att-value="l.sale_rate" t-on-input="(ev) => this.setLine('sale_rate', ev)"/></label>
                                        </t>
                                        <t t-else="">
                                            <label class="ei-fd-field"><span>Basic rate / MTL</span><input class="ei-fd-in is-num" inputmode="decimal" t-att-value="l.basic_rate" t-on-input="(ev) => this.setLine('basic_rate', ev)"/><em t-if="this.cl and this.cl.basic_rate and this.str(this.cl.basic_rate) !== this.str(l.basic_rate)" class="ei-fd-hint is-warn">Contract says <t t-out="this.fmt(this.cl.basic_rate)"/></em></label>
                                            <label class="ei-fd-field ei-fd-check"><input type="checkbox" t-att-checked="l.sale_typed" t-on-change="(ev) => this.setLine('sale_typed', ev)"/><span>Type the sale rate instead</span></label>
                                            <label t-if="!l.sale_typed" class="ei-fd-field"><span>Sale = mill rate +/−</span><input class="ei-fd-in is-num" inputmode="decimal" t-att-value="l.sale_offset" t-on-input="(ev) => this.setLine('sale_offset', ev)"/></label>
                                            <label t-else="" class="ei-fd-field"><span>Sale rate / MTL</span><input class="ei-fd-in is-num" inputmode="decimal" t-att-value="l.sale_rate" t-on-input="(ev) => this.setLine('sale_rate', ev)"/></label>
                                            <t t-if="this.lineBasis === 'with_cn'">
                                                <label class="ei-fd-field"><span>Credit note on THIS coil</span><input class="ei-fd-in is-num" inputmode="decimal" t-att-value="l.cn_amount" t-on-input="(ev) => this.setLine('cn_amount', ev)"/></label>
                                                <label class="ei-fd-field is-wide"><span>Credit note text (as on the paper)</span><input class="ei-fd-in" t-att-value="l.cn_text" t-on-input="(ev) => this.setLine('cn_text', ev)"/></label>
                                            </t>
                                            <label t-if="this.cl and this.cl.basic_rate and this.str(this.cl.basic_rate) !== this.str(l.basic_rate)" class="ei-fd-field is-wide"><span>Why the basic rate differs from the contract</span><input class="ei-fd-in" t-att-value="l.rate_note" t-on-input="(ev) => this.setLine('rate_note', ev)"/></label>
                                        </t>
                                    </div>

                                    <!-- the answer -->
                                    <t t-set="p" t-value="this.state.preview"/>
                                    <p t-if="p and p.code_issue" class="ei-fd-warnbox ei-fd-codewarn" role="alert" t-out="p.code_issue"/>
                                    <div t-if="p and p.ok" t-att-class="'ei-fd-answer is-' + p.result" aria-live="polite">
                                        <dl class="ei-fd-figs">
                                            <div><dt>Purchase / MTL</dt><dd class="ei-fd-num" t-out="this.fmt(p.purchase_rate)"/></div>
                                            <div><dt>Sale / MTL</dt><dd class="ei-fd-num" t-out="this.fmt(p.sale_rate)"/></div>
                                            <div class="is-key"><dt>Spread / MTL</dt><dd class="ei-fd-num ei-fd-spread" t-out="this.signed(p.spread_per_mtl)"/></div>
                                            <div><dt>Coil (<t t-out="this.fmt(p.quantity, 3)"/> MTL)</dt><dd class="ei-fd-num" t-out="this.signed(p.total_spread) + ' ' + p.currency"/></div>
                                        </dl>
                                        <dl class="ei-fd-figs ei-fd-amounts">
                                            <div><dt>Purchase amount</dt><dd class="ei-fd-num" t-out="this.fmt(p.purchase_total)"/></div>
                                            <div><dt>Sale amount</dt><dd class="ei-fd-num" t-out="this.fmt(p.sale_total)"/></div>
                                        </dl>
                                        <p t-if="p.base" class="ei-fd-muted">In <t t-out="p.base.currency"/> at the rate of <t t-out="p.base.rate_date"/>: purchase <t t-out="this.fmt(p.base.purchase_rate)"/>, sale <t t-out="this.fmt(p.base.sale_rate)"/>, coil spread <t t-out="this.signed(p.base.total_spread)"/>.</p>
                                        <table class="ei-fd-steps"><caption class="visually-hidden">How it is worked out</caption><tbody>
                                            <tr t-foreach="p.rows" t-as="r" t-key="r.key"><th scope="row" t-out="r.label"/><td class="ei-fd-num" t-out="this.fmt(r.value)"/></tr>
                                        </tbody></table>
                                        <p t-if="p.formula" class="ei-fd-muted">Formula <t t-out="p.formula.code"/> v<t t-out="p.formula.version"/> from the contract. Gross spread before costs and taxes; not booked profit.</p>
                                        <label t-if="p.result === 'loss'" class="ei-fd-field is-wide ei-fd-lossbox"><span>Sold below cost: why? (an approver will check)</span><input class="ei-fd-in" t-att-value="l.loss_reason" t-on-input="(ev) => this.setLine('loss_reason', ev)"/></label>
                                    </div>
                                    <p t-elif="p and !p.ok" class="ei-fd-warnbox" t-out="p.error"/>
                                    <p t-elif="this.state.previewBusy" class="ei-fd-muted">Working it out…</p>
                                    <p t-else="" class="ei-fd-muted">Choose the material, type the weight and pick a method: the calculation appears here.</p>

                                    <p t-if="this.state.error" class="ei-fd-error" role="alert" t-out="this.state.error"/>
                                    <div class="ei-fd-actions is-sticky">
                                        <button t-if="l.id" class="ei-fd-btn is-ghost ei-fd-danger" t-on-click="() => this.deleteLine(l)">Remove coil</button>
                                        <span class="ei-fd-spacer"/>
                                        <button class="ei-fd-btn" t-on-click="() => this.closeLine()">Close</button>
                                        <button class="ei-fd-btn" t-att-disabled="this.state.busy" t-on-click="() => this.saveLine(true)">Save &amp; Add Coil</button>
                                        <button class="ei-fd-btn is-primary" t-att-disabled="this.state.busy" t-on-click="() => this.saveLine()" title="Ctrl+S">Save Draft</button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </div>
            </section>
        </div>
    </t>
</templates>
