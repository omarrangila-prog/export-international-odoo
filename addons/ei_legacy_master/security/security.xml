<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_groups_privilege_ei_master" model="res.groups.privilege">
        <field name="name">Export International - Master Codes</field>
        <field name="category_id" ref="base.module_category_accounting"/>
    </record>

    <record id="group_ei_user" model="res.groups">
        <field name="name">Export International user (sees the app)</field>
        <field name="privilege_id" ref="res_groups_privilege_ei_master"/>
        <field name="implied_ids" eval="[(6, 0, [ref('base.group_user')])]"/>
    </record>
    <record id="group_ei_auditor" model="res.groups">
        <field name="name">Auditor (read-only)</field>
        <field name="privilege_id" ref="res_groups_privilege_ei_master"/>
        <field name="implied_ids" eval="[(6, 0, [ref('group_ei_user')])]"/>
    </record>
    <record id="group_ei_importer" model="res.groups">
        <field name="name">Code importer</field>
        <field name="privilege_id" ref="res_groups_privilege_ei_master"/>
        <field name="implied_ids" eval="[(6, 0, [ref('group_ei_user')])]"/>
    </record>
    <record id="group_ei_mapping_approver" model="res.groups">
        <field name="name">Mapping approver (accountant)</field>
        <field name="privilege_id" ref="res_groups_privilege_ei_master"/>
        <field name="implied_ids" eval="[(6, 0, [ref('group_ei_user')])]"/>
    </record>
</odoo>
