<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ei_rule_list" model="ir.ui.view">
        <field name="name">ei.rule.list</field>
        <field name="model">ei.rule</field>
        <field name="arch" type="xml">
            <list create="0" delete="0" decoration-muted="not enabled">
                <field name="code"/><field name="name"/>
                <field name="enabled" widget="boolean_toggle"/>
                <field name="days"/><field name="days_label" optional="show"/>
                <field name="last_run_at"/><field name="last_found"/><field name="last_created"/>
            </list>
        </field>
    </record>
    <record id="ei_rule_form" model="ir.ui.view">
        <field name="name">ei.rule.form</field>
        <field name="model">ei.rule</field>
        <field name="arch" type="xml">
            <form create="0" delete="0">
                <header>
                    <button name="action_preview" type="object" string="Show what it finds now" class="btn-primary"
                            help="Looks at the real records and shows what it WOULD do. Creates nothing."/>
                    <button name="action_run" type="object" string="Run now" invisible="not enabled"
                            confirm="This leaves real reminders for your colleagues. Continue?"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name"/></h1><h3 class="text-muted"><field name="code"/></h3></div>
                    <div class="alert alert-info" role="alert" invisible="enabled">
                        This automation is <b>switched off</b>. You can preview it. Switch it on when the business has agreed the numbers below.
                    </div>
                    <group>
                        <group string="Settings (the business decides)">
                            <field name="enabled"/>
                            <label for="days"/><div class="o_row"><field name="days"/><span class="text-muted"><field name="days_label"/></span></div>
                            <field name="repeat_days"/>
                            <field name="max_per_run"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group string="Last run">
                            <field name="last_run_at"/><field name="last_found"/><field name="last_created"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="What it does"><field name="explanation" readonly="1"/></page>
                        <page string="History">
                            <field name="run_ids" readonly="1">
                                <list><field name="run_at"/><field name="mode"/><field name="user_id"/><field name="found"/><field name="created"/><field name="errors"/></list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="ei_rule_run_form" model="ir.ui.view">
        <field name="name">ei.rule.run.form</field>
        <field name="model">ei.rule.run</field>
        <field name="arch" type="xml">
            <form create="0" edit="0" delete="0">
                <sheet>
                    <div class="oe_title"><h1><field name="rule_id"/></h1></div>
                    <div class="alert alert-info" role="alert" invisible="mode != 'preview'">
                        <b>Preview.</b> Nothing was created. This is what a real run would do right now.
                    </div>
                    <div class="alert alert-danger" role="alert" invisible="not errors"><field name="errors"/></div>
                    <group>
                        <group><field name="mode"/><field name="run_at"/><field name="user_id"/></group>
                        <group><field name="found"/><field name="created"/></group>
                    </group>
                    <field name="finding_ids">
                        <list create="0" delete="0" decoration-success="status in ('reminded', 'would_remind')" decoration-muted="status in ('skipped_open', 'skipped_recent', 'skipped_cap')" decoration-danger="status == 'no_owner'">
                            <field name="record_name"/><field name="summary"/><field name="owners"/><field name="status"/>
                            <button name="action_open_record" type="object" string="Open" icon="fa-external-link" title="Open the record"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>
    <record id="ei_rule_action" model="ir.actions.act_window">
        <field name="name">Automation rules</field>
        <field name="res_model">ei.rule</field>
        <field name="view_mode">list,form</field>
        <field name="help"><![CDATA[<p class="o_view_nocontent_smiling_face">No automation rules are set up</p>]]></field>
    </record>
    <menuitem id="menu_ei_rules" name="Automation rules" parent="ei_legacy_master.menu_ei_master" action="ei_rule_action" sequence="25"
              groups="ei_management_dashboard.group_ei_management,ei_legacy_master.group_ei_auditor"/>
</odoo>
