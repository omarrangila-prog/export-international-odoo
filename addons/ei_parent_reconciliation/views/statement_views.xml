<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ei_parent_import_wizard_form" model="ir.ui.view">
        <field name="name">ei.parent.import.wizard.form</field>
        <field name="model">ei.parent.import.wizard</field>
        <field name="arch" type="xml">
            <form>
                <group><field name="partner_id"/><field name="date_from"/><field name="date_to"/>
                    <field name="file" filename="filename"/><field name="filename" invisible="1"/>
                        <field name="currency_id" invisible="1"/><field name="control_total" required="1"/></group>
                <p class="text-muted">CSV or XLSX with Invoice No and Amount columns (Tax, Date, Contract, DA, Qty optional).
                    Matching never changes a posted entry.</p>
                <footer>
                    <button string="Import and match" name="action_import" type="object" class="btn-primary"/>
                    <button string="Cancel" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="ei_parent_import_wizard_action" model="ir.actions.act_window">
        <field name="name">Import parent statement</field>
        <field name="res_model">ei.parent.import.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
    <record id="ei_parent_statement_list" model="ir.ui.view">
        <field name="name">ei.parent.statement.list</field>
        <field name="model">ei.parent.statement</field>
        <field name="arch" type="xml">
            <list decoration-success="state == 'signed'" decoration-danger="state == 'rejected'">
                <field name="name"/><field name="partner_id"/><field name="date_from"/><field name="date_to"/>
                <field name="n_matched"/><field name="n_exceptions"/><field name="n_open"/><field name="state" widget="badge"/>
            </list>
        </field>
    </record>
    <record id="ei_parent_statement_form" model="ir.ui.view">
        <field name="name">ei.parent.statement.form</field>
        <field name="model">ei.parent.statement</field>
        <field name="arch" type="xml">
            <form create="0">
                <header>
                    <button name="action_match" string="Re-run matching" type="object" invisible="state in ('resolved', 'signed', 'rejected')"/>
                    <button name="action_check_assigned" string="Owners assigned" type="object" invisible="state != 'classified'"/>
                    <button name="action_check_resolved" string="All resolved" type="object" invisible="state != 'assigned'"/>
                    <button name="action_sign" string="Sign off" type="object" class="btn-primary" invisible="state != 'resolved'"
                            groups="ei_parent_reconciliation.group_ei_recon_approver"/>
                    <field name="state" widget="statusbar" statusbar_visible="imported,classified,assigned,resolved,signed"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <div class="alert alert-danger" role="alert" invisible="not issues"><field name="issues" nolabel="1"/></div>
                    <group>
                        <group><field name="partner_id"/><field name="date_from"/><field name="date_to"/><field name="filename"/></group>
                        <group><field name="statement_total"/><field name="internal_total"/><field name="n_matched"/>
                            <field name="n_exceptions"/><field name="n_open"/><field name="imported_by"/><field name="signed_by"/></group>
                    </group>
                    <div class="alert alert-warning" role="status" invisible="not control_entered_by or completeness_diff == 0">
                        The total printed on the parent's statement differs from the imported rows: a row is missing or extra. It cannot be signed off like this.
                    </div>
                    <group string="Where the parent's total goes">
                        <group><field name="currency_id" invisible="1"/>
                            <field name="control_total" readonly="state in ('signed', 'rejected')"/><field name="control_entered_by"/>
                            <field name="completeness_diff"/></group>
                        <group><field name="amount_matched"/><field name="amount_differences"/><field name="amount_parent_only"/>
                            <field name="amount_duplicates"/><field name="amount_internal_only"/></group>
                    </group>
                    <field name="line_ids">
                        <list editable="bottom" decoration-success="status == 'matched'" decoration-danger="status in ('amount_difference', 'tax_difference', 'hs_difference')"
                              decoration-warning="status in ('missing_internal', 'missing_supplier', 'possible_match', 'duplicate')">
                            <field name="invoice_no" readonly="1"/><field name="date" readonly="1"/><field name="status" readonly="1"/>
                            <field name="statement_amount" readonly="1"/><field name="internal_amount" readonly="1"/><field name="difference"/>
                            <field name="hs_code" readonly="1" optional="hide"/><field name="our_hs_codes" optional="hide"/>
                            <field name="internal_move_id" readonly="1"/><field name="owner_id"/>
                            <field name="adjustment_move_id"/><field name="resolution" readonly="1"/><field name="resolution_state"/>
                            <field name="currency_id" column_invisible="1"/>
                        </list>
                    </field>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="ei_parent_statement_action" model="ir.actions.act_window">
        <field name="name">Parent Statements</field>
        <field name="res_model">ei.parent.statement</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="ei_parent_line_exceptions_action" model="ir.actions.act_window">
        <field name="name">Open Exceptions</field>
        <field name="res_model">ei.parent.statement.line</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('status', '!=', 'matched'), ('resolution_state', '=', 'open')]</field>
    </record>
</odoo>
