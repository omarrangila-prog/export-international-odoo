<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="group_ei_dispatch_officer" model="res.groups">
        <field name="name">Dispatch officer (enters liftings)</field>
        <field name="privilege_id" ref="ei_contract_da.res_groups_privilege_ei_contract"/>
        <field name="implied_ids" eval="[(6, 0, [ref('ei_contract_da.group_ei_contract_staff')])]"/>
    </record>
    <record id="group_ei_lifting_reviewer" model="res.groups">
        <field name="name">Lifting reviewer (verifies)</field>
        <field name="privilege_id" ref="ei_contract_da.res_groups_privilege_ei_contract"/>
        <field name="implied_ids" eval="[(6, 0, [ref('group_ei_dispatch_officer')])]"/>
    </record>
</odoo>
