<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ei_mig_import_form" model="ir.ui.view">
        <field name="name">ei.migration.import.wizard.form</field>
        <field name="model">ei.migration.import.wizard</field>
        <field name="arch" type="xml">
            <form>
                <p>Choose the <b>manifest.json</b> written by <code>migration/foxpro_extract.py</code> on a copy of the FoxPro folder.
                    Recording it changes nothing in the accounts; the same manifest recorded twice is kept once.</p>
                <group><field name="file" filename="filename"/><field name="filename" invisible="1"/></group>
                <footer><button name="action_import" type="object" string="Record the extract" class="btn-primary"/><button special="cancel" string="Cancel"/></footer>
            </form>
        </field>
    </record>
    <record id="ei_mig_import_action" model="ir.actions.act_window">
        <field name="name">Record an old-system extract</field>
        <field name="res_model">ei.migration.import.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="help" type="html"><p>Choose the manifest.json written by the extract script.</p></field>
    </record>
    <record id="ei_mig_extract_list" model="ir.ui.view">
        <field name="name">ei.migration.extract.list</field>
        <field name="model">ei.migration.extract</field>
        <field name="arch" type="xml">
            <list create="0">
                <field name="name"/><field name="source_files"/><field name="n_tables"/><field name="n_records"/><field name="n_deleted"/>
                <field name="n_changed"/><field name="imported_by"/><field name="imported_at"/>
            </list>
        </field>
    </record>
    <record id="ei_mig_extract_form" model="ir.ui.view">
        <field name="name">ei.migration.extract.form</field>
        <field name="model">ei.migration.extract</field>
        <field name="arch" type="xml">
            <form create="0" edit="0">
                <sheet>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <div class="alert alert-warning" role="status" invisible="not problems"><field name="problems" nolabel="1"/></div>
                    <group>
                        <group><field name="source_files"/><field name="n_tables"/><field name="n_records"/><field name="n_deleted"/></group>
                        <group><field name="n_changed"/><field name="previous_id"/><field name="imported_by"/><field name="imported_at"/><field name="manifest_sha256"/></group>
                    </group>
                    <field name="table_ids">
                        <list decoration-warning="changed or memo_missing or not codepage_known or records_in_header != records_found">
                            <field name="file"/><field name="version" optional="hide"/><field name="codepage"/><field name="codepage_known" optional="hide"/>
                            <field name="n_fields"/><field name="records_in_header"/><field name="records_found"/><field name="deleted"/><field name="live"/>
                            <field name="memo_missing" optional="show"/><field name="changed"/><field name="sha256" optional="hide"/>
                        </list>
                    </field>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="ei_mig_extract_action" model="ir.actions.act_window">
        <field name="name">Old system extracts</field>
        <field name="res_model">ei.migration.extract</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html"><p class="o_view_nocontent_smiling_face">No extract of the old FoxPro system yet</p>
            <p>Run <code>python3 migration/foxpro_extract.py COPY_OF_FOXPRO_FOLDER OUTPUT</code> on a copy of the old folder, then record its manifest.json here.</p></field>
    </record>
    <record id="ei_mig_control_list" model="ir.ui.view">
        <field name="name">ei.migration.control.list</field>
        <field name="model">ei.migration.control</field>
        <field name="arch" type="xml">
            <list decoration-success="status == 'agrees'" decoration-danger="status == 'differs' and not signed_by" decoration-muted="signed_by">
                <field name="cutoff"/><field name="kind"/><field name="label"/><field name="legacy_value"/><field name="odoo_value"/>
                <field name="difference"/><field name="status" widget="badge"/><field name="signed_by"/>
            </list>
        </field>
    </record>
    <record id="ei_mig_control_form" model="ir.ui.view">
        <field name="name">ei.migration.control.form</field>
        <field name="model">ei.migration.control</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_sign" type="object" string="Sign (second person)" class="btn-primary" invisible="signed_by"
                            groups="account.group_account_manager"/>
                </header>
                <sheet>
                    <group>
                        <group><field name="cutoff" readonly="signed_by"/><field name="kind" readonly="signed_by"/><field name="label" readonly="signed_by"/>
                            <field name="legacy_value" readonly="signed_by"/>
                            <field name="table_id" invisible="kind != 'table_count'" readonly="signed_by"/>
                            <field name="deleted_rule" invisible="kind != 'table_count'" readonly="signed_by"/>
                            <field name="account_id" invisible="kind != 'account'" readonly="signed_by"/>
                            <field name="journal_id" invisible="kind != 'bank'" readonly="signed_by"/></group>
                        <group><field name="odoo_value"/><field name="difference"/><field name="status" widget="badge"/>
                            <field name="entered_by"/><field name="signed_by"/><field name="signed_at"/></group>
                    </group>
                    <field name="note" readonly="signed_by" placeholder="Why it differs (cut-off, items not migrated, ...)"/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="ei_mig_control_action" model="ir.actions.act_window">
        <field name="name">Old system against the books</field>
        <field name="res_model">ei.migration.control</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html"><p class="o_view_nocontent_smiling_face">No control total from the old system yet</p>
            <p>Type each total exactly as the old system's report prints it (record counts, trial balance, bank, receivables, payables, accounts). Odoo shows its own figure at the same cut-off and the difference. A second person signs.</p></field>
    </record>
    <record id="ei_integration_log_list" model="ir.ui.view">
        <field name="name">ei.integration.log.list</field>
        <field name="model">ei.integration.log</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0" decoration-danger="error" decoration-muted="status in ('rejected', 'failed')">
                <field name="happened_at"/><field name="source"/><field name="name"/><field name="filename"/><field name="status"/>
                <field name="attempts" optional="hide"/><field name="error"/><field name="user_id"/><field name="fingerprint" optional="hide"/>
            </list>
        </field>
    </record>
    <record id="ei_integration_log_search" model="ir.ui.view">
        <field name="name">ei.integration.log.search</field>
        <field name="model">ei.integration.log</field>
        <field name="arch" type="xml">
            <search><field name="name"/><field name="filename"/><field name="fingerprint"/>
                <filter name="problems" string="With a problem" domain="[('error', '!=', False)]"/>
                <group><filter name="by_source" string="Source" context="{'group_by': 'source'}"/></group></search>
        </field>
    </record>
    <record id="ei_integration_log_action" model="ir.actions.act_window">
        <field name="name">Imports and integrations log</field>
        <field name="res_model">ei.integration.log</field>
        <field name="view_mode">list</field>
        <field name="help" type="html"><p class="o_view_nocontent_smiling_face">Nothing imported yet</p>
            <p>Every bank statement, parent statement, code list, old-system extract and tax submission appears here with its fingerprint. No feed is shown as live unless it is.</p></field>
    </record>
    <menuitem id="menu_ei_integration_log" name="Imports and integrations log" parent="ei_legacy_master.menu_ei_master" action="ei_integration_log_action" sequence="47"/>
    <menuitem id="menu_ei_mig_extract_new" name="Record an old-system extract" parent="ei_legacy_master.menu_ei_master" action="ei_mig_import_action" sequence="44"/>
    <menuitem id="menu_ei_mig_extract" name="Old system extracts" parent="ei_legacy_master.menu_ei_master" action="ei_mig_extract_action" sequence="45"/>
    <menuitem id="menu_ei_mig_control" name="Old system against the books" parent="ei_legacy_master.menu_ei_master" action="ei_mig_control_action" sequence="46"/>
</odoo>
