<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_groups_privilege_ei_cash" model="res.groups.privilege">
        <field name="name">Export International - Cash Book</field>
        <field name="category_id" ref="base.module_category_accounting"/>
    </record>
    <record id="group_ei_cash_clerk" model="res.groups">
        <field name="name">Cash clerk (maker)</field>
        <field name="privilege_id" ref="res_groups_privilege_ei_cash"/>
        <field name="implied_ids" eval="[(6, 0, [ref('ei_legacy_master.group_ei_user'), ref('account.group_account_invoice')])]"/>
    </record>
    <record id="group_ei_cash_approver" model="res.groups">
        <field name="name">Cash approver (checker)</field>
        <field name="privilege_id" ref="res_groups_privilege_ei_cash"/>
        <field name="implied_ids" eval="[(6, 0, [ref('group_ei_cash_clerk'), ref('account.group_account_user')])]"/>
    </record>
</odoo>
