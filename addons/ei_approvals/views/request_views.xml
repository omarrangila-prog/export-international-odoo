<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ei_approval_request_list" model="ir.ui.view">
        <field name="name">ei.approval.request.list</field><field name="model">ei.approval.request</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0" decoration-danger="state == 'rejected'" decoration-warning="state in ('returned', 'superseded')"
                  decoration-success="state == 'approved'" decoration-info="state == 'pending'">
                <field name="name"/><field name="flow"/><field name="partner_id"/><field name="maker_id"/><field name="approver_id"/>
                <field name="submitted_at"/><field name="amount" sum="Total"/><field name="currency_id" optional="show"/>
                <field name="state" widget="badge"/><field name="round" optional="hide"/><field name="decided_by" optional="show"/>
                <field name="decided_at" optional="hide"/><field name="company_id" optional="hide" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>
    <record id="ei_approval_request_form" model="ir.ui.view">
        <field name="name">ei.approval.request.form</field><field name="model">ei.approval.request</field>
        <field name="arch" type="xml">
            <form create="0" edit="0" delete="0">
                <header><field name="state" widget="statusbar" statusbar_visible="pending,approved"/></header>
                <sheet>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <group><field name="flow"/><field name="partner_id"/><field name="amount"/><field name="currency_id" invisible="1"/>
                            <field name="round"/><field name="company_id" groups="base.group_multi_company"/></group>
                        <group><field name="maker_id"/><field name="approver_id"/><field name="needs_assignment"/><field name="submitted_at"/>
                            <field name="due_at"/><field name="decided_by"/><field name="decided_at"/></group>
                    </group>
                    <group><field name="submit_note"/><field name="decision_note"/></group>
                    <field name="event_ids">
                        <list><field name="at"/><field name="kind"/><field name="user_id"/><field name="note"/><field name="record_state"/></list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>
    <record id="ei_approval_request_search" model="ir.ui.view">
        <field name="name">ei.approval.request.search</field><field name="model">ei.approval.request</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/><field name="partner_id"/><field name="maker_id"/><field name="approver_id"/>
                <filter name="f_pending" string="Pending" domain="[('state', '=', 'pending')]"/>
                <filter name="f_mine" string="Assigned to me" domain="[('approver_id', '=', uid), ('state', '=', 'pending')]"/>
                <filter name="f_overdue" string="Overdue" domain="[('is_overdue', '=', True)]"/>
                <filter name="f_returned" string="Returned" domain="[('state', '=', 'returned')]"/>
                <separator/>
                <filter name="g_flow" string="Document type" context="{'group_by': 'flow'}"/>
                <filter name="g_state" string="Status" context="{'group_by': 'state'}"/>
            </search>
        </field>
    </record>
    <record id="ei_approval_request_action" model="ir.actions.act_window">
        <field name="name">Approval requests (list)</field><field name="res_model">ei.approval.request</field>
        <field name="view_mode">list,form</field><field name="context">{'search_default_f_pending': 1}</field>
        <field name="help" type="html"><p class="o_view_nocontent_smiling_face">No approval request here</p>
            <p>When someone submits a contract, DA, daily order, cash voucher or truck loading, its request appears here and in the Approvals centre.</p></field>
    </record>
    <record id="ei_approvals_center_action" model="ir.actions.client">
        <field name="name">Approvals</field><field name="tag">ei_approvals.center</field>
    </record>
</odoo>
