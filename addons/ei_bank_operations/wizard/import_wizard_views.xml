<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ei_bank_import_wizard_form" model="ir.ui.view">
        <field name="name">ei.bank.import.wizard.form</field>
        <field name="model">ei.bank.import.wizard</field>
        <field name="arch" type="xml">
            <form string="Import bank statement">
                <p class="text-muted">Stages the statement only. Nothing reaches the ledger until it is reviewed,
                    approved by a second person and posted by a third.</p>
                <group>
                    <field name="journal_id"/>
                    <field name="file" filename="filename"/><field name="filename" invisible="1"/>
                    <field name="opening_balance"/><field name="closing_balance"/>
                </group>
                <footer>
                    <button string="Import" name="action_import" type="object" class="btn-primary"/>
                    <button string="Cancel" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="ei_bank_import_wizard_action" model="ir.actions.act_window">
        <field name="name">Import bank statement</field>
        <field name="res_model">ei.bank.import.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <record id="ei_bank_line_wizard_form" model="ir.ui.view">
        <field name="name">ei.bank.line.wizard.form</field>
        <field name="model">ei.bank.line.wizard</field>
        <field name="arch" type="xml">
            <form string="Review bank lines">
                <group>
                    <field name="decision" widget="radio"/>
                    <field name="partner_id" invisible="decision != 'verify'" required="decision == 'verify'"/>
                    <field name="note" placeholder="Evidence (payment image checked, bank call...) / rejection reason"/>
                </group>
                <field name="line_ids" widget="many2many_tags" readonly="1"/>
                <footer>
                    <button string="Apply" name="action_apply" type="object" class="btn-primary"/>
                    <button string="Cancel" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="ei_bank_line_wizard_action" model="ir.actions.act_window">
        <field name="name">Review bank lines</field>
        <field name="res_model">ei.bank.line.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="model_ei_bank_import_line"/>
        <field name="binding_view_types">list,form</field>
    </record>

    <record id="ei_legacy_link_wizard_form" model="ir.ui.view">
        <field name="name">ei.legacy.link.wizard.form</field>
        <field name="model">ei.legacy.link.wizard</field>
        <field name="arch" type="xml">
            <form string="Link to existing partner">
                <group><field name="code_id" readonly="1"/><field name="partner_id"/></group>
                <footer>
                    <button string="Link" name="action_link" type="object" class="btn-primary"/>
                    <button string="Cancel" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
