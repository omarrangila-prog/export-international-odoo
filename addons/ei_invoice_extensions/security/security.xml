<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="group_ei_invoicing" model="res.groups">
        <field name="name">Invoicing staff (intake, customer invoices)</field>
        <field name="privilege_id" ref="ei_contract_da.res_groups_privilege_ei_contract"/>
        <field name="implied_ids" eval="[(6, 0, [ref('ei_contract_da.group_ei_contract_staff'), ref('account.group_account_invoice')])]"/>
    </record>
    <record id="group_ei_invoice_approver" model="res.groups">
        <field name="name">Invoice approver (mismatches, price adjustments)</field>
        <field name="privilege_id" ref="ei_contract_da.res_groups_privilege_ei_contract"/>
        <field name="implied_ids" eval="[(6, 0, [ref('group_ei_invoicing')])]"/>
    </record>
</odoo>
