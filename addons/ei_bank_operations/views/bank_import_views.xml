<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ei_bank_import_list" model="ir.ui.view">
        <field name="name">ei.bank.import.list</field>
        <field name="model">ei.bank.import</field>
        <field name="arch" type="xml">
            <list decoration-danger="state == 'rejected'" decoration-success="state == 'posted'" decoration-warning="state == 'received'">
                <field name="name"/><field name="journal_id"/><field name="imported_at"/><field name="imported_by"/>
                <field name="n_lines"/><field name="n_duplicate"/><field name="n_open"/>
                <field name="closing_diff"/><field name="state" widget="badge"/>
            </list>
        </field>
    </record>
    <record id="ei_bank_import_form" model="ir.ui.view">
        <field name="name">ei.bank.import.form</field>
        <field name="model">ei.bank.import</field>
        <field name="arch" type="xml">
            <form create="0" delete="0">
                <header>
                    <button name="action_suggest" string="Suggest parties" type="object"
                            invisible="state in ('approved', 'posted', 'rejected')"/>
                    <button name="action_approve" string="Approve" type="object" class="btn-primary"
                            groups="ei_bank_operations.group_ei_bank_approver"
                            invisible="state not in ('received', 'validated', 'proposed')"/>
                    <button name="action_post" string="Post to ledger" type="object" class="btn-primary"
                            groups="ei_bank_operations.group_ei_bank_poster" invisible="state != 'approved'"/>
                    <button name="action_reject" string="Reject batch" type="object"
                            groups="ei_bank_operations.group_ei_bank_approver"
                            invisible="state in ('posted', 'rejected')"/>
                    <field name="state" widget="statusbar" statusbar_visible="validated,proposed,approved,posted"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <div class="alert alert-warning" role="alert" invisible="not issues">
                        <field name="issues" nolabel="1"/>
                    </div>
                    <group>
                        <group>
                            <field name="journal_id"/><field name="filename"/><field name="file_sha256"/>
                            <field name="imported_by"/><field name="imported_at"/>
                            <field name="approved_by"/><field name="posted_by"/><field name="posted_at"/>
                            <field name="statement_id"/>
                        </group>
                        <group string="Balance matching">
                            <field name="currency_id" invisible="1"/>
                            <field name="ledger_opening"/><field name="opening_balance"/><field name="opening_diff"/>
                            <field name="computed_closing"/><field name="closing_balance"/><field name="closing_diff"/>
                            <field name="variance_note" readonly="state in ('approved', 'posted', 'rejected')"/>
                        </group>
                    </group>
                    <field name="line_ids">
                        <list decoration-muted="state in ('duplicate', 'rejected')" decoration-success="state == 'posted'">
                            <field name="sequence"/><field name="date"/><field name="ref"/><field name="narration"/>
                            <field name="amount"/><field name="suggested_partner_id"/><field name="confidence"/>
                            <field name="partner_id"/><field name="state" widget="badge"/>
                        </list>
                    </field>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="ei_bank_import_action" model="ir.actions.act_window">
        <field name="name">Statement Imports</field>
        <field name="res_model">ei.bank.import</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="ei_bank_line_list" model="ir.ui.view">
        <field name="name">ei.bank.import.line.list</field>
        <field name="model">ei.bank.import.line</field>
        <field name="arch" type="xml">
            <list decoration-muted="state in ('duplicate', 'rejected')" decoration-warning="state in ('new', 'proposed')"
                  decoration-success="state == 'posted'" create="0" delete="0">
                <field name="import_id" optional="hide"/><field name="journal_id"/><field name="date"/>
                <field name="ref"/><field name="narration"/><field name="amount" sum="Total"/>
                <field name="suggested_partner_id"/><field name="confidence"/><field name="match_note" optional="show"/>
                <field name="partner_id"/><field name="state" widget="badge"/>
            </list>
        </field>
    </record>
    <record id="ei_bank_line_form" model="ir.ui.view">
        <field name="name">ei.bank.import.line.form</field>
        <field name="model">ei.bank.import.line</field>
        <field name="arch" type="xml">
            <form create="0" delete="0">
                <header>
                    <button name="%(ei_bank_line_wizard_action)d" type="action" string="Verify / Unidentified / Reject"
                            class="btn-primary" invisible="state in ('duplicate', 'rejected', 'posted')"/>
                    <field name="state" widget="statusbar" statusbar_visible="new,proposed,verified,posted"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="import_id"/><field name="date"/><field name="ref"/><field name="narration"/>
                            <field name="amount"/><field name="currency_id" invisible="1"/>
                        </group>
                        <group>
                            <field name="suggested_partner_id"/><field name="confidence"/><field name="match_note"/>
                            <field name="partner_id"/><field name="verified_by"/><field name="evidence_note"/>
                            <field name="duplicate_of_id" invisible="not duplicate_of_id"/>
                            <field name="statement_line_id" invisible="not statement_line_id"/>
                        </group>
                    </group>
                    <separator string="Allocation to invoices / bills (needs verified party)"/>
                    <field name="allocation_ids" readonly="state != 'verified'">
                        <list editable="bottom">
                            <field name="invoice_id" domain="[('state', '=', 'posted'), ('partner_id', 'child_of', parent.partner_id), ('payment_state', 'in', ('not_paid', 'partial'))]"/>
                            <field name="amount"/>
                        </list>
                    </field>
                    <group><field name="allocated"/></group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="ei_bank_line_search" model="ir.ui.view">
        <field name="name">ei.bank.import.line.search</field>
        <field name="model">ei.bank.import.line</field>
        <field name="arch" type="xml">
            <search>
                <field name="narration"/><field name="ref"/><field name="partner_id"/><field name="import_id"/>
                <filter name="todo" string="To review" domain="[('state', 'in', ('new', 'proposed'))]"/>
                <filter name="unident" string="Unidentified" domain="[('is_unidentified', '=', True)]"/>
                <filter name="dups" string="Duplicates" domain="[('state', '=', 'duplicate')]"/>
                <filter name="receipts" string="Receipts" domain="[('amount', '&gt;', 0)]"/>
                <filter name="payments" string="Payments" domain="[('amount', '&lt;', 0)]"/>
                <group>
                    <filter name="g_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="g_journal" string="Bank" context="{'group_by': 'journal_id'}"/>
                    <filter name="g_day" string="Imported day" context="{'group_by': 'imported_on'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="ei_bank_line_action" model="ir.actions.act_window">
        <field name="name">Lines to Review</field>
        <field name="res_model">ei.bank.import.line</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_todo': 1}</field>
    </record>
</odoo>
